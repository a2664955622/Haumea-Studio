# systemd unit for Haumea Studio's telemetry and crash report server.
# Copy to /etc/systemd/system/haumea-server.service (see DEPLOY.md).

[Unit]
Description=Haumea Studio telemetry and crash reports
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haumea-server
Group=haumea-server
ExecStart=/usr/bin/python3 /opt/haumea-server/haumea_server.py --config /etc/haumea-server/env
Restart=on-failure
RestartSec=5

# Its data in /var/lib/haumea-server, made and owned by systemd.
StateDirectory=haumea-server
StateDirectoryMode=0700
ReadWritePaths=/var/lib/haumea-server

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=128M

[Install]
WantedBy=multi-user.target
