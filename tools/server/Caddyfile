# Caddy for Haumea Studio's telemetry and crash reports. Caddy gets the HTTPS
# certificates by itself once both names point at this server.
# Copy to /etc/caddy/Caddyfile, or add these blocks to the one you have.

telemetry.itsneufox.xyz {
	# No access log: it would keep IP addresses.
	log {
		output discard
	}
	# The bare name opens the public statistics.
	redir / /stats 302
	@allowed path /haumea/telemetry/ping /privacy /stats
	handle @allowed {
		request_body {
			max_size 1KB
		}
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		respond 404
	}
}

reports.itsneufox.xyz {
	log {
		output discard
	}
	@reports path /haumea/reports
	handle @reports {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8787
	}
	# The dashboard asks for its own password (HTTP basic auth).
	@dashboard path /dashboard /dashboard/*
	handle @dashboard {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		respond 404
	}
}
