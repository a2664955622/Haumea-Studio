// Generated by Haumea Studio from GTA San Andreas map objects.
// This file uses absolute world coordinates and XYZ rotation degrees.
// Text encoding: Windows-1252
// Unchanged world objects are omitted from this file.
// A moved, rotated, deleted, or material-edited world object is exported
// as RemoveBuildingForPlayer plus a scripted replacement when it is not deleted.
// Call Haumea_showcase_CreateObjects() from OnGameModeInit (it also adds the player classes).
// Call Haumea_showcase_ShowForPlayer(playerid) from OnPlayerConnect for gang zones, map icons and sounds.
// Game sounds play when a player walks in: call Haumea_showcase_SoundArea(playerid, areaid, true)
// from OnPlayerEnterDynamicArea and Haumea_showcase_SoundArea(playerid, areaid, false) from
// OnPlayerLeaveDynamicArea.
// The NPC_* calls need open.mp with its NPCs component; SA-MP 0.3.7 has no NPC natives.
// Uses custom models: needs SA-MP 0.3.DL or open.mp with the server's models/artconfig.txt.
// Call Haumea_showcase_RemoveWorldObjectsForPlayer(playerid) from OnPlayerConnect.
// Deleted world objects have a removal line but no CreateObject call.
// Call Haumea_showcase_CreateTextDraws() from OnGameModeInit and Haumea_showcase_ShowTextDraws(playerid)
// when a player should see the textdraws (it also creates the per-player ones).

#include <open.mp>
#include <streamer>


