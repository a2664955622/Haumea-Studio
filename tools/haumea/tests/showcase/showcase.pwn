stock Haumea_showcase_CreateTextDraws()
{
	Haumea_showcase_td0 = TextDrawCreate(320.000, 20.000, "~y~HAUMEA PLAZA");
	TextDrawLetterSize(Haumea_showcase_td0, 0.600, 2.000);
	TextDrawAlignment(Haumea_showcase_td0, TEXT_DRAW_ALIGN:2);
	TextDrawFont(Haumea_showcase_td0, TEXT_DRAW_FONT:3);
}

stock Haumea_showcase_ShowTextDraws(playerid)
{
