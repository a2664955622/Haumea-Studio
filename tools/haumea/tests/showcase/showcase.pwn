stock Haumea_showcase_RemoveWorldObjectsForPlayer(playerid)
{
	RemoveBuildingForPlayer(playerid, 4206, 1479.554688, -1639.609375, 13.648438, 0.25); // PershingPool_LAn
}

static Haumea_showcase_zone_3 = -1;

static Haumea_showcase_soundId[1], Float:Haumea_showcase_soundAt[1][4], bool:Haumea_showcase_soundStop[1], Haumea_showcase_numSounds;
static Haumea_showcase_soundArea[1];

stock Haumea_showcase_AddSound(soundid, Float:x, Float:y, Float:z, Float:radius, bool:stopOnLeave,
	worldid = -1, interiorid = -1)
{
	if(Haumea_showcase_numSounds == sizeof Haumea_showcase_soundId)
		return;
	new i = Haumea_showcase_numSounds++;
	Haumea_showcase_soundId[i] = soundid;
	Haumea_showcase_soundAt[i][0] = x; Haumea_showcase_soundAt[i][1] = y; Haumea_showcase_soundAt[i][2] = z; Haumea_showcase_soundAt[i][3] = radius;
	Haumea_showcase_soundStop[i] = stopOnLeave;
	Haumea_showcase_soundArea[i] = _:CreateDynamicSphere(x, y, z, radius, worldid, interiorid);
}

stock Haumea_showcase_SoundArea(playerid, {DynamicArea, _}:areaid, bool:entered)
{
	for(new i = 0; i < Haumea_showcase_numSounds; i++){
		if(Haumea_showcase_soundArea[i] != _:areaid)
			continue;
		if(entered)
			PlayerPlaySound(playerid, Haumea_showcase_soundId[i], Haumea_showcase_soundAt[i][0], Haumea_showcase_soundAt[i][1], Haumea_showcase_soundAt[i][2]);
		else if(Haumea_showcase_soundStop[i])
			PlayerPlaySound(playerid, 0, 0.0, 0.0, 0.0);
	}
}

