# Guides as in Photoshop: a preset of four columns inside 20 unit margins
# (columns 142.5 wide, 10 apart), and one typed at an exact place.
open "$UI_FIXTURES/ui_map.pwn"
click_item '*' 'TextDraws'
wait 8
click_item '*' 'Canvas'
wait 3
click_item '*' '##guides'
wait 3
click_item '' '4 columns'
wait 3
set_item '' 'Position' "100"
click_item '' 'Add'
wait 3
close_popup
wait 3
move 900 400
shortcut save_map_as
wait 5
click_item 'Save TextDraws As' 'Save'
wait 5
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn.xml" 'at="20"'
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn.xml" 'at="172.5"'
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn.xml" 'at="620"'
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn.xml" 'at="428"'
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn.xml" 'at="100"'
