# Generic player attachments remain protected when no attachment preview is open.
open "$UI_FIXTURES/ui_mapping_player_attachments.pwn"
assert objects == 4
shortcut window_tools
wait 5
click_item 'Tools' 'Duplicate cleanup'
click_item 'Tools' 'Match properties and materials'
click_item 'Tools' 'Find duplicates'
wait 3
assert duplicates == 1
click_item 'Tools' 'Remove duplicates'
wait 3
click_item '*' 'Remove##confirm_duplicates'
wait 5
assert objects == 3
assert pawn_count 'SetPlayerAttachedObject(' == 2
# Center Parent must rebase, rather than recreate, an existing bone attachment.
open "$UI_FIXTURES/ui_center_npc_parent.pwn"
wait 8
assert objects == 2
click_object model=1271
wait 5
assert pawn_contains ', 4, 1271, 6,'
# Edit the pivot through Tools, with the automatic attachment panel closed.
click_item '*' 'Windows'
wait 3
click_item '*' 'Attachment Workspace'
wait 3
assert no_window 'Attachment Workspace'
click_item 'Tools' 'Duplicate cleanup'
click_item 'Tools' 'Pivot'
wait 3
click_item 'Tools' 'Center Parent'
wait 5
assert pawn_contains ', 4, 1271, 6,'
assert pawn_contains '1.500000, 1.000000, 0.800000, 0xFFAA0000, 0xFF00AA00'
move 800 400
key Ctrl+Z
wait 5
assert pawn_contains ', 4, 1271, 6,'
key Ctrl+Y
wait 5
assert pawn_contains ', 4, 1271, 6,'
assert pawn_contains '1.500000, 1.000000, 0.800000, 0xFFAA0000, 0xFF00AA00'
close_popup
key Ctrl+S
wait 5
reopen
wait 8
assert objects == 2
assert pawn_contains ', 4, 1271, 6,'
