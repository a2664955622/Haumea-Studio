# Explicit conversion at an unchanged pose, through the inspector and context menu.
open "$UI_FIXTURES/ui_map.pwn"
click_world 1479.554688 -1639.609375 13.648438
wait 5
shortcut window_object_info
wait 5
assert selected.model == 4206
assert pawn_lacks 'RemoveBuildingForPlayer(playerid, 4206'
assert item 'Object Info' 'Convert to map object'
click_item 'Object Info' 'Convert to map object'
wait 5
assert selected.z == 13.648438
assert pawn_count 'RemoveBuildingForPlayer(playerid, 4206' == 1
assert pawn_count 'CreateObject(4206,' == 1
assert pawn_contains 'CreateObject(4206, 1479.554688, -1639.609375, 13.648438'
assert pawn_contains 'CreateDynamicObject(4206, 1479.554688, -1639.609375, 13.648438' streamer
assert xml_contains 'forceWorldReplacement="true"'
assert no_item 'Object Info' 'Convert to map object'
move 800 400
key Ctrl+Z
wait 5
assert pawn_lacks 'RemoveBuildingForPlayer(playerid, 4206'
assert pawn_lacks 'CreateObject(4206,'
key Ctrl+Y
wait 5
assert pawn_count 'RemoveBuildingForPlayer(playerid, 4206' == 1
assert pawn_count 'CreateObject(4206,' == 1
key Ctrl+S
wait 5
reopen
wait 8
assert objects == 4
assert pawn_count 'RemoveBuildingForPlayer(playerid, 4206' == 1
assert pawn_count 'CreateObject(4206,' == 1
assert xml_contains 'forceWorldReplacement="true"'
# Select all the occurrences of another world model through Instances.
click_world 2063.132813 -1731.781250 15.273438 right
wait 5
assert item '*' 'Convert to map object'
click_item '*' 'Find instances'
wait 5
click_item 'Object Browser' 'Select all'
wait 5
assert selected == 1
assert selected_world == 1
assert selected.model == 3555
# The context action also converts the selection without moving it.
click_world 2063.132813 -1731.781250 15.273438 right
click_item '*' 'Convert to map object'
wait 5
assert pawn_count 'RemoveBuildingForPlayer(playerid, 3555' == 1
assert pawn_count 'CreateObject(3555,' == 1
assert pawn_contains 'CreateObject(3555, 2063.132812, -1731.781250, 15.273438'
assert pawn_count 'RemoveBuildingForPlayer(playerid, 4206' == 1
move 800 400
key Ctrl+Z
wait 5
assert pawn_lacks 'RemoveBuildingForPlayer(playerid, 3555'
assert pawn_lacks 'CreateObject(3555,'
assert pawn_count 'RemoveBuildingForPlayer(playerid, 4206' == 1
