# Player class: Place, then skin, team and two weapons in Object Info; save, reopen.
open "$UI_FIXTURES/ui_floor.pwn"
shortcut window_browser
wait 5
click_item 'Object Browser' 'SA-MP'
wait 5
click_item 'Object Browser' 'Place' 2
wait 3
click_world 2000 -3000 4
wait 5
key Esc
assert objects == 2
shortcut window_object_info
wait 5
click_item 'Object Info' 'Skin'
wait 3
set_item '*' 'ID' "105"
wait 3
close_popup
wait 3
click_item 'Object Info' 'Team (AddPlayerClassEx)'
wait 3
set_item 'Object Info' '##team' "3"
wait 3
click_item 'Object Info' '##weapon' 1
wait 3
scroll_until '*' 'Desert Eagle'
click_item '*' 'Desert Eagle'
wait 3
set_item 'Object Info' '##ammo' "100" 1
wait 3
click_item 'Object Info' '##weapon' 2
wait 3
scroll_until '*' 'M4'
click_item '*' 'M4'
wait 3
set_item 'Object Info' '##ammo' "300" 2
wait 3
key Ctrl+S
wait 5
reopen
wait 10
assert objects == 2
assert pawn_contains "AddPlayerClassEx(3, 105, "
assert pawn_contains ", WEAPON_DEAGLE, 100, WEAPON_M4, 300, WEAPON_FIST, 0);"
