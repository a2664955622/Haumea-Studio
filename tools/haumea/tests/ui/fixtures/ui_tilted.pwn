// Slabs as a tester's stunt track has them: SA-MP objects tilted by a few
// degrees, which SA's IPL loader would flatten (|qx|, |qy| <= 0.05) but
// CreateObject never does, plus triples at or next to gimbal lock.
#include <a_samp>

public OnGameModeInit()
{
	CreateObject(19377, 2000.000000, -3000.000000, 5.000000, -1.999987, 0.000000, 0.000000);
	CreateObject(19377, 2010.000000, -3000.000000, 5.000000, -1.999987, 0.000000, -44.999988);
	CreateObject(19377, 2020.000000, -3000.000000, 5.000000, -5.099997, 0.000000, 0.000000);
	CreateObject(19377, 2030.000000, -3000.000000, 5.000000, -0.499960, 0.000000, -0.700110);
	CreateObject(19377, 2040.000000, -3000.000000, 5.000000, 1.700008, 0.000000, -44.999988);
	CreateObject(19377, 2050.000000, -3000.000000, 5.000000, -0.199983, 0.000000, -135.400000);
	CreateObject(19377, 2060.000000, -3000.000000, 5.000000, 0.000000, 3.000000, 20.000000);
	CreateObject(19377, 2070.000000, -3000.000000, 5.000000, 89.999992, -45.199764, -89.999961);
	CreateObject(19377, 2080.000000, -3000.000000, 5.000000, 0.000000, 28.300006, 90.000106);
	CreateObject(19377, 2090.000000, -3000.000000, 5.000000, 180.000000, 90.000000, 0.000000);
	CreateObject(19377, 2100.000000, -3000.000000, 5.000000, 0.000000, 0.000000, 33.000000);
	return 1;
}
