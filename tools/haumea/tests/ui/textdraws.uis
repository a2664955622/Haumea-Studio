# TextDraw mode: textdraws in a file of their own, on a canvas instead of the world.
open "$UI_FIXTURES/ui_map.pwn"
click_item '*' 'Windows'
wait 3
click_item '*' 'TextDraws'
wait 5
assert window "TextDraws"
assert item '*' 'Exit'
click_item 'TextDraws' 'Text'
wait 5
assert textdraws == 1
assert textdraw.0.x == 280
drag_item '*' 'hit' 120 60
wait 5
assert textdraw.0.x > 300
drag_item '*' 'resize' 40 40
wait 5
assert textdraw.0.letter_y > 1.2
move 640 700
key Ctrl+Z
wait 5
assert textdraw.0.letter_y ~ 1.12
# Map editing is off: Ctrl+Z undid the textdraw, the map's objects stay.
assert objects == 4
# Delete is one step on the textdraw file's own undo.
click_item 'TextDraws' 'Delete'
wait 5
assert textdraws == 0
key Ctrl+Z
wait 5
assert textdraws == 1
assert objects == 4
# The map has no textdraws; Save As writes them beside it.
assert pawn_lacks "TextDrawCreate("
click_item 'TextDraws' 'Save As...'
wait 5
click_item 'Save TextDraws As' 'Save'
wait 5
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn" "= TextDrawCreate("
assert file_contains "$UI_FIXTURES/ui_map_textdraws.pwn" "stock Haumea_ui_map_textdraws_ShowTextDraws(playerid)"
# Esc leaves the mode.
key Escape
wait 5
assert no_window "TextDraws"
assert no_item '*' 'Exit'
