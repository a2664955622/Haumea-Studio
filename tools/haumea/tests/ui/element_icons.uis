# Labels, sounds, map icons, gang zones and path points are editor icons, not
# GTA models: place one of each, then select each by clicking its icon (the
# floor under them is at 2000 -3000, so a missed click selects the floor; the
# placement lands within a few cm of the click, hence the 0.5 m windows).
open "$UI_FIXTURES/ui_floor.pwn"
shortcut window_browser
wait 5
click_item 'Object Browser' 'SA-MP'
wait 5
# Label, gang zone, map icon, path point.
click_item 'Object Browser' 'Place' 6
wait 3
click_world 1998 -3002 4
wait 3
click_item 'Object Browser' 'Place' 7
wait 3
click_world 2002 -2998 4
wait 3
click_item 'Object Browser' 'Place' 8
wait 3
click_world 1998 -2998 4
wait 3
click_item 'Object Browser' 'Place' 4
wait 3
click_world 2001 -3001 4
wait 3
# Sound, near the end of the list.
scroll_until 'Object Browser' 'Race'
click_item 'Object Browser' 'Place' -3
wait 3
click_world 2002 -3002 4
wait 5
key Esc
assert objects == 6
assert proxy_draws == 0
# Each one by its icon.
click_world 1998 -3002 4
wait 3
assert selected == 1
assert selected.x > 1997.5
assert selected.x < 1998.5
assert selected.y > -3002.5
assert selected.y < -3001.5
click_world 2002 -2998 4
wait 3
assert selected.x > 2001.5
assert selected.x < 2002.5
assert selected.y > -2998.5
assert selected.y < -2997.5
click_world 1998 -2998 4
wait 3
assert selected.x > 1997.5
assert selected.x < 1998.5
assert selected.y > -2998.5
assert selected.y < -2997.5
click_world 2001 -3001 4
wait 3
assert selected.x > 2000.5
assert selected.x < 2001.5
assert selected.y > -3001.5
assert selected.y < -3000.5
click_world 2002 -3002 4
wait 3
assert selected.x > 2001.5
assert selected.x < 2002.5
assert selected.y > -3002.5
assert selected.y < -3001.5
assert proxy_draws == 0
