open "$UI_FIXTURES/ui_materials.pwn"
wait 5
shortcut window_map_objects
wait 10
click_item 'Map Objects' 'crate_a (gunbox)'
wait 3
hold Ctrl
click_item 'Map Objects' 'crate_b (gunbox)'
click_item 'Map Objects' 'wall_c (wall001)'
release Ctrl
wait 3
assert selected == 3
shortcut window_object_info
wait 10
wait 10
assert pawn_count "\"white\"" == 3
click_item 'Object Info' 'Browse textures...'
wait 10
dump_items '*'
exit
