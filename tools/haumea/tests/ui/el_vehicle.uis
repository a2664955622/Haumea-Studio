# Vehicle: find the Infernus by ID and place it, then colours, respawn delay and plate in Object Info; save, reopen.
open "$UI_FIXTURES/ui_floor.pwn"
shortcut window_browser
wait 5
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Objects'
wait 3
click_item 'Object Browser' '##search_objects'
type "411"
wait 5
click_item 'Object Browser' '##tile'
wait 3
click_item 'Object Browser' 'Place'
wait 3
click_world 2000 -3000 4
wait 5
key Esc
assert objects == 2
# Standing on the floor (top z 4.0 on the fixture, 4.09 in the game), its wheels
# under the origin: not lifted by the body's bounding sphere (6.56 and 7.07 were).
assert selected == 1
assert selected.z > 4.3
assert selected.z < 5.2
shortcut window_object_info
wait 5
set_item 'Object Info' 'Colour 1/##value' "3" tab
wait 3
set_item 'Object Info' 'Colour 2/##value' "1" tab
wait 3
set_item 'Object Info' 'Respawn delay' "120" tab
wait 3
set_item 'Object Info' 'Number plate' "HAUMEA"
wait 3
# Leave the field: Ctrl+S does nothing while one is being edited.
close_popup
wait 3
key Ctrl+S
wait 5
reopen
wait 10
assert objects == 2
assert pawn_contains "= AddStaticVehicleEx(411, "
assert pawn_contains ", 0.000000, 3, 1, 120); // infernus"
assert pawn_contains "SetVehicleNumberPlate(Haumea_ui_floor_vehicle_0, \"HAUMEA\");"
