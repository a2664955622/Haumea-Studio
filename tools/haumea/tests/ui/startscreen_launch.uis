# At launch the start screen shows over the editor (the runner sets
# HAUMEA_START_SCREEN=1 for this script). A new workspace is pinned, and
# Skip goes on to the editor.
wait 30
assert window "Welcome to Haumea Studio"
assert objects == 0
click_item 'Welcome to Haumea Studio' 'New workspace'
wait 3
set_item 'Welcome to Haumea Studio' '##parent' "."
wait 3
set_item 'Welcome to Haumea Studio' '##name' "made"
wait 3
click_item 'Welcome to Haumea Studio' 'Create workspace'
wait 5
click_item 'Welcome to Haumea Studio' '##pin'
wait 3
assert item 'Welcome to Haumea Studio' '##unpin'
click_item 'Welcome to Haumea Studio' 'Skip'
wait 5
assert no_window "Welcome to Haumea Studio"
