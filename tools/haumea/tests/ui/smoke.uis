# The driver itself: windows by shortcut and menu, keys, asserts.
open "$UI_FIXTURES/ui_map.pwn"
wait 5
assert objects == 4
shortcut window_textures
wait 3
assert window "Texture Browser"
shortcut window_textures
wait 3
assert no_window "Texture Browser"
click_item '*' 'Windows'
wait 3
click_item '*' 'TextDraws'
wait 3
assert window "TextDraws"
