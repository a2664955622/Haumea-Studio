# Feature navigation and complete setup panels; choosing a type does not place it.
open "$UI_FIXTURES/ui_floor.pwn"
wait 40
assert window 'Object Browser'
click_item 'Object Browser' '##browser_source'
wait 3
assert no_item '*' 'SA-MP'
assert item '*' 'Characters'
assert item '*' 'Paths'
assert item '*' 'Markers'
assert item '*' 'Text & audio'
assert item '*' 'Zones'
assert item '*' 'Prefabs'
assert item '*' 'Favourites'
assert item '*' 'Model files'
click_item '*' 'Characters'
wait 5
assert item 'Object Browser' '##place Actor'
assert item 'Object Browser' '##place Player class'
assert item 'Object Browser' '##place NPC'
assert no_item 'Object Browser' '##place Pickup'
assert item 'Object Browser' '##place_skin'
assert item 'Object Browser' '##element_place'
assert placing == 0
assert clipped_items == 0
click_item 'Object Browser' '##place_skin'
wait 3
set_item '*' 'ID' '105'
close_popup
wait 3
assert placing == 0
click_item 'Object Browser' 'Keep placing'
click_item 'Object Browser' '##element_place'
wait 3
assert placing == 1
click_world 1998 -3001 4
click_world 2002 -3001 4
wait 5
assert objects == 3
assert pawn_contains 'CreateActor(105,'
key Esc
wait 3
assert placing == 0
assert item 'Object Browser' '##place_skin'
# Classes and NPCs have their own skin choices.
click_item 'Object Browser' '##place Player class'
wait 3
assert placing == 0
click_item 'Object Browser' '##element_place'
wait 3
click_world 1998 -2998 4
wait 3
assert selected.model == 7
assert pawn_contains 'AddPlayerClass(7,'
key Esc
wait 3
click_item 'Object Browser' '##place NPC'
wait 3
assert placing == 0
click_item 'Object Browser' '##place_skin'
wait 3
set_item '*' 'ID' '101'
close_popup
wait 3
click_item 'Object Browser' '##element_place'
wait 3
click_world 2002 -2998 4
wait 3
assert selected.model == 101
assert pawn_contains 'NPC_Spawn('
# Opening another feature stops the previous placement tool.
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Paths'
wait 5
assert placing == 0
assert item 'Object Browser' '##place_path'
assert no_item 'Object Browser' '##place_skin'
click_item 'Object Browser' '##place_path'
wait 3
set_item '*' '##newpath' 'route_test'
wait 5
assert item 'Object Browser' '##place_path'
click_item 'Object Browser' '##element_place'
wait 3
click_world 1999 -3002 4
click_world 2001 -3002 4
wait 4
assert pawn_contains 'route_test'
assert pawn_contains 'NPC_AddPointToPath('
key Esc
wait 3
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Markers'
wait 3
assert item 'Object Browser' '##place_pickup'
click_item 'Object Browser' '##place Checkpoint'
wait 3
assert item 'Object Browser' '##place_race'
assert placing == 0
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Text & audio'
wait 3
assert item 'Object Browser' '##place Sound'
assert item 'Object Browser' '##place 3D text label'
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Zones'
wait 3
assert item 'Object Browser' '##place Gang zone'
assert item 'Object Browser' '##place Dynamic area'
assert clipped_items == 0
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Prefabs'
wait 3
assert item 'Object Browser' '##browser_source'
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Objects'
wait 3
assert item 'Object Browser' '##search_objects'
