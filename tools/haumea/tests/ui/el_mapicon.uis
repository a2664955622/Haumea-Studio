# Map icon: icon, colour and style in Object Info; save, reopen.
open "$UI_FIXTURES/ui_floor.pwn"
shortcut window_browser
wait 5
click_item 'Object Browser' '##browser_source'
wait 3
click_item '*' 'Markers'
wait 3
click_item 'Object Browser' '##place Map icon'
wait 3
click_item 'Object Browser' '##element_place'
wait 3
click_world 2000 -3000 4
wait 5
key Esc
assert objects == 2
shortcut window_object_info
wait 5
click_item 'Object Info' 'Icon'
wait 3
click_item '*' 'Ammu-Nation'
wait 3
click_item 'Object Info' 'Style'
wait 3
click_item '*' 'Global (MAPICON_GLOBAL)'
wait 3
key Ctrl+S
wait 5
reopen
wait 10
assert objects == 2
assert pawn_contains "SetPlayerMapIcon(playerid,"
assert pawn_contains ", 6, "
assert pawn_contains "MAPICON_GLOBAL"
