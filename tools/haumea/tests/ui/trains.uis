# A Brown Streak placed from the Object Browser lands on a track with its
# three coaches, and only the engine is written. Any game: the click is 3 m from
# the synthetic game's track (y -3100) and far from the real game's tracks, so
# it must snap to the nearest one; then the engine stands where the client puts
# a train placed there (off_track about 0), wherever that is.
open "$UI_FIXTURES/ui_floor.pwn"
camera 2000 -3060 40 2000 -3100 10
shortcut window_browser
wait 5
click_item 'Object Browser' 'Objects'
wait 3
click_item 'Object Browser' '##search_objects'
type "538"
wait 5
click_item 'Object Browser' '##tile'
wait 3
click_item 'Object Browser' 'Place'
wait 3
click_world 2000 -3097 10
wait 5
key Esc
assert selected == 1
assert selected.model == 538
assert train.cars == 4
assert train.0.model == 538
assert train.1.model == 570
assert train.3.model == 570
assert train.off_track < 0.5
assert pawn_count "AddStaticVehicleEx(538," == 1
assert pawn_lacks "(570,"
