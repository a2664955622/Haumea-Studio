# Radar art from objects: the map's footprints as one radar art layer, Apply
# as one undo step, then streamed per-player zones saved and reopened into
# the layer again (no gang zone elements in the map).
open "$UI_FIXTURES/ui_radar.pwn"
shortcut window_tools
wait 5
wait 10
assert objects == 6
assert radar_zones == 0
click_item 'Tools' 'Radar art from objects'
wait 30
scroll_until 'Tools' '##radar_apply'
wait 3
click_item 'Tools' '##radar_apply'
wait 10
assert objects == 6
assert radar_zones > 0
key Esc
move 640 400
key Ctrl+Z
wait 5
assert radar_zones == 0
key Ctrl+Y
wait 5
assert radar_zones > 0
scroll_until 'Tools' 'Shown as'
wait 3
click_item 'Tools' 'Shown as'
wait 3
click_item '*' 'Streamed per-player zones'
wait 30
scroll_until 'Tools' '##radar_apply'
wait 3
click_item 'Tools' '##radar_apply'
wait 10
assert radar_zones > 0
key Ctrl+S
wait 5
assert pawn_contains "_AddStreamedZone("
assert pawn_lacks "// radar art"
assert xml_contains 'radar="true"'
assert pawn_contains "CreateDynamicRectangle("
reopen
wait 10
assert objects == 6
assert radar_zones > 0
assert pawn_contains "_AddStreamedZone("
