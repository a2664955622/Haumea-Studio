# An old map's textdraws are read-only until moved to a file of their own.
open "$UI_FIXTURES/ui_old_textdraws.pwn"
wait 5
assert pawn_contains "TextDrawCreate(320.000, 10.000"
click_item '*' 'Windows'
wait 3
click_item '*' 'TextDraws'
wait 5
assert textdraws == 0
click_item 'TextDraws' 'Move to a separate file...'
wait 5
click_item '*' 'Move textdraws to a separate file'
wait 5
assert textdraws == 1
assert file_contains "$UI_FIXTURES/ui_old_textdraws_textdraws.pwn" "OldTitle = TextDrawCreate(320.000, 10.000"
assert pawn_lacks "TextDrawCreate("
