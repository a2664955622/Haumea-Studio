# Gang zone: size and colour in Object Info; save, reopen.
open "$UI_FIXTURES/ui_floor.pwn"
shortcut window_browser
wait 5
click_item 'Object Browser' 'SA-MP'
wait 5
click_item 'Object Browser' 'Place' 7
wait 3
click_world 2000 -3000 4
wait 5
key Esc
assert objects == 2
shortcut window_object_info
wait 5
set_item 'Object Info' 'Size (X, Y)/#0' "40"
set_item 'Object Info' 'Size (X, Y)/#1' "20"
wait 3
set_item 'Object Info' 'Colour/##X' "0"
set_item 'Object Info' 'Colour/##Y' "255"
set_item 'Object Info' 'Colour/##Z' "0"
set_item 'Object Info' 'Colour/##W' "128"
wait 3
key Ctrl+S
wait 5
reopen
wait 10
assert objects == 2
assert pawn_contains "GangZoneCreate(1979.9"
assert pawn_contains "0x00FF0080"
