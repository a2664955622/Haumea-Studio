// Generated by Haumea Studio from GTA San Andreas map objects.
// This file uses absolute world coordinates and XYZ rotation degrees.
// Text encoding: Windows-1252
// Unchanged world objects are omitted from this file.
// A moved, rotated, deleted, or material-edited world object is exported
// as RemoveBuildingForPlayer plus a scripted replacement when it is not deleted.
// Call Haumea_hv_zones_CreateObjects() from OnGameModeInit (it also adds the player classes).
// Call Haumea_hv_zones_ShowForPlayer(playerid) from OnPlayerConnect for gang zones, map icons and sounds.
// Per-player gang zones (CreatePlayerGangZone) need open.mp; SA-MP 0.3.7 has none.
// Streamed gang zones need the streamer: call Haumea_hv_zones_ZoneArea(playerid, areaid) from
// OnPlayerEnterDynamicArea and OnPlayerLeaveDynamicArea, and Haumea_hv_zones_ZoneUpdate(playerid)
// from OnPlayerSpawn.

#include <open.mp>
#include <streamer>

static hv_zones_gate = -1;

static Float:Haumea_hv_zones_pzoneAt[2][4], Haumea_hv_zones_pzoneColour[2], Haumea_hv_zones_numPZones;

stock Haumea_hv_zones_AddPlayerZone(Float:minx, Float:miny, Float:maxx, Float:maxy, colour)
{
	if(Haumea_hv_zones_numPZones == sizeof Haumea_hv_zones_pzoneColour)
		return;
	new i = Haumea_hv_zones_numPZones++;
	Haumea_hv_zones_pzoneAt[i][0] = minx; Haumea_hv_zones_pzoneAt[i][1] = miny; Haumea_hv_zones_pzoneAt[i][2] = maxx; Haumea_hv_zones_pzoneAt[i][3] = maxy;
	Haumea_hv_zones_pzoneColour[i] = colour;
}

static Float:Haumea_hv_zones_szoneAt[3][4], Haumea_hv_zones_szoneColour[3], Haumea_hv_zones_szoneCell[3], Haumea_hv_zones_szoneNext[3], Haumea_hv_zones_numSZones;
static Haumea_hv_zones_cellFirst[35] = { -1, ... }, Haumea_hv_zones_cellArea[35], bool:Haumea_hv_zones_cellsMade;
static bool:Haumea_hv_zones_cellLoaded[MAX_PLAYERS][35];
static Haumea_hv_zones_liveZone[MAX_PLAYERS][2], Haumea_hv_zones_liveIndex[MAX_PLAYERS][2], Haumea_hv_zones_numLive[MAX_PLAYERS];

static stock Haumea_hv_zones_ZoneCellAt(Float:at, Float:origin, cells)
{
	return clamp(floatround((at - origin) / 250.0, floatround_floor), 0, cells - 1);
}

stock Haumea_hv_zones_AddStreamedZone(Float:minx, Float:miny, Float:maxx, Float:maxy, colour)
{
	if(!Haumea_hv_zones_cellsMade){
		Haumea_hv_zones_cellsMade = true;
		for(new c = 0; c < sizeof Haumea_hv_zones_cellArea; c++){
			new Float:x = 750.0 + float(c % 7) * 250.0, Float:y = -1750.0 + float(c / 7) * 250.0;
			Haumea_hv_zones_cellArea[c] = _:CreateDynamicRectangle(x, y, x + 250.0, y + 250.0);
		}
	}
	if(Haumea_hv_zones_numSZones == sizeof Haumea_hv_zones_szoneColour)
		return;
	new i = Haumea_hv_zones_numSZones++;
	Haumea_hv_zones_szoneAt[i][0] = minx; Haumea_hv_zones_szoneAt[i][1] = miny; Haumea_hv_zones_szoneAt[i][2] = maxx; Haumea_hv_zones_szoneAt[i][3] = maxy;
	Haumea_hv_zones_szoneColour[i] = colour;
	Haumea_hv_zones_szoneCell[i] = Haumea_hv_zones_ZoneCellAt((miny + maxy) / 2.0, -1750.0, 5) * 7 +
		Haumea_hv_zones_ZoneCellAt((minx + maxx) / 2.0, 750.0, 7);
	Haumea_hv_zones_szoneNext[i] = Haumea_hv_zones_cellFirst[Haumea_hv_zones_szoneCell[i]];
	Haumea_hv_zones_cellFirst[Haumea_hv_zones_szoneCell[i]] = i;
}

stock Haumea_hv_zones_ZoneReset(playerid)
{
	for(new c = 0; c < sizeof Haumea_hv_zones_cellArea; c++)
		Haumea_hv_zones_cellLoaded[playerid][c] = false;
	Haumea_hv_zones_numLive[playerid] = 0;
}

stock Haumea_hv_zones_ZoneUpdate(playerid)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	new col = floatround((x - 750.0) / 250.0, floatround_floor), row = floatround((y + 1750.0) / 250.0, floatround_floor);
	for(new pass = 0; pass < 2; pass++){
		for(new c = 0; c < sizeof Haumea_hv_zones_cellArea; c++){
			new dx = c % 7 - col, dy = c / 7 - row;
			new bool:near = dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1;
			if(pass == 0 && Haumea_hv_zones_cellLoaded[playerid][c] && !near){
				for(new k = Haumea_hv_zones_numLive[playerid] - 1; k >= 0; k--){
					if(Haumea_hv_zones_szoneCell[Haumea_hv_zones_liveIndex[playerid][k]] != c)
						continue;
					PlayerGangZoneDestroy(playerid, Haumea_hv_zones_liveZone[playerid][k]);
					new last = --Haumea_hv_zones_numLive[playerid];
					Haumea_hv_zones_liveZone[playerid][k] = Haumea_hv_zones_liveZone[playerid][last];
					Haumea_hv_zones_liveIndex[playerid][k] = Haumea_hv_zones_liveIndex[playerid][last];
				}
				Haumea_hv_zones_cellLoaded[playerid][c] = false;
			}else if(pass == 1 && !Haumea_hv_zones_cellLoaded[playerid][c] && near){
				Haumea_hv_zones_cellLoaded[playerid][c] = true;
				for(new i = Haumea_hv_zones_cellFirst[c]; i != -1 && Haumea_hv_zones_numLive[playerid] < sizeof Haumea_hv_zones_liveZone[]; i = Haumea_hv_zones_szoneNext[i]){
					new zone = CreatePlayerGangZone(playerid, Haumea_hv_zones_szoneAt[i][0], Haumea_hv_zones_szoneAt[i][1], Haumea_hv_zones_szoneAt[i][2], Haumea_hv_zones_szoneAt[i][3]);
					if(zone == INVALID_GANG_ZONE)
						break;
					PlayerGangZoneShow(playerid, zone, Haumea_hv_zones_szoneColour[i]);
					new k = Haumea_hv_zones_numLive[playerid]++;
					Haumea_hv_zones_liveZone[playerid][k] = zone;
					Haumea_hv_zones_liveIndex[playerid][k] = i;
				}
			}
		}
	}
}

stock bool:Haumea_hv_zones_ZoneArea(playerid, {DynamicArea, _}:areaid)
{
	for(new c = 0; c < sizeof Haumea_hv_zones_cellArea; c++){
		if(Haumea_hv_zones_cellArea[c] == _:areaid){
			Haumea_hv_zones_ZoneUpdate(playerid);
			return true;
		}
	}
	return false;
}

stock Haumea_hv_zones_CreateObjects()
{
	hv_zones_gate = GangZoneCreate(1590.000000, -1910.000000, 1630.000000, -1870.000000); // gangzone [gang zone]

	// ---- radar art ----
	Haumea_hv_zones_AddPlayerZone(1520.000000, -1700.000000, 1530.000000, -1660.000000, 0x59A14FC8); // gangzone @group("radar art") @note("park")
	Haumea_hv_zones_AddPlayerZone(1500.000000, -1700.000000, 1520.000000, -1680.000000, 0x4E79A7C8); // radar art @group("radar art")

	// ---- streamed art ----
	Haumea_hv_zones_AddStreamedZone(1000.000000, -1000.000000, 1010.000000, -990.000000, 0xE15759C8); // gangzone @group("streamed art")
	Haumea_hv_zones_AddStreamedZone(1300.000000, -1000.000000, 1340.000000, -980.000000, 0xEDC948FF); // gangzone @group("streamed art")
	Haumea_hv_zones_AddStreamedZone(2000.000000, -1500.000000, 2004.000000, -1496.000000, 0x76B7B280); // gangzone @group("streamed art")
}

stock Haumea_hv_zones_ShowForPlayer(playerid)
{
	for(new i = 0; i < Haumea_hv_zones_numPZones; i++){
		new zone = CreatePlayerGangZone(playerid, Haumea_hv_zones_pzoneAt[i][0], Haumea_hv_zones_pzoneAt[i][1], Haumea_hv_zones_pzoneAt[i][2], Haumea_hv_zones_pzoneAt[i][3]);
		if(zone != INVALID_GANG_ZONE)
			PlayerGangZoneShow(playerid, zone, Haumea_hv_zones_pzoneColour[i]);
	}
	Haumea_hv_zones_ZoneReset(playerid);
	GangZoneShowForPlayer(playerid, hv_zones_gate, 0xFF000088); // gangzone
}
