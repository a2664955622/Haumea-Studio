// Generated by Haumea Studio from GTA San Andreas map objects.
// This file uses absolute world coordinates and XYZ rotation degrees.
// Text encoding: Windows-1252
// Unchanged world objects are omitted from this file.
// A moved, rotated, deleted, or material-edited world object is exported
// as RemoveBuildingForPlayer plus a scripted replacement when it is not deleted.
// Call Haumea_hv_loops_CreateObjects() from OnGameModeInit (it also adds the player classes).
// The NPC_* calls need open.mp with its NPCs component; SA-MP 0.3.7 has no NPC natives.
// NPCs that walk their path again: call Haumea_hv_loops_OnNPCFinishMovePath(npcid, pathid)
// from OnNPCFinishMovePath(npcid, pathid), or they stop at the end.

#include <open.mp>

#if !defined NPC_PATH_LOOP
	#define NPC_PATH_LOOP (1)
	#define NPC_PATH_BACK_AND_FORTH (2)
#endif

static Haumea_hv_loops_repeatNpc[2], Haumea_hv_loops_repeatPath[2], NPC_MOVE_TYPE:Haumea_hv_loops_repeatType[2],
	Float:Haumea_hv_loops_repeatSpeed[2], bool:Haumea_hv_loops_repeatReversed[2], Haumea_hv_loops_repeatMode[2], Haumea_hv_loops_numRepeats;

stock bool:Haumea_hv_loops_MoveByPathRepeat(npcid, pathid, NPC_MOVE_TYPE:moveType, Float:moveSpeed,
	bool:reversed, mode)
{
	if(Haumea_hv_loops_numRepeats < sizeof Haumea_hv_loops_repeatNpc){
		new i = Haumea_hv_loops_numRepeats++;
		Haumea_hv_loops_repeatNpc[i] = npcid; Haumea_hv_loops_repeatPath[i] = pathid; Haumea_hv_loops_repeatType[i] = moveType;
		Haumea_hv_loops_repeatSpeed[i] = moveSpeed; Haumea_hv_loops_repeatReversed[i] = reversed; Haumea_hv_loops_repeatMode[i] = mode;
	}
	return NPC_MoveByPath(npcid, pathid, moveType, moveSpeed, reversed);
}

stock bool:Haumea_hv_loops_OnNPCFinishMovePath(npcid, pathid)
{
	for(new i = 0; i < Haumea_hv_loops_numRepeats; i++){
		if(Haumea_hv_loops_repeatNpc[i] != npcid || Haumea_hv_loops_repeatPath[i] != pathid)
			continue;
		if(Haumea_hv_loops_repeatMode[i] == NPC_PATH_BACK_AND_FORTH)
			Haumea_hv_loops_repeatReversed[i] = !Haumea_hv_loops_repeatReversed[i];
		return NPC_MoveByPath(npcid, pathid, Haumea_hv_loops_repeatType[i], Haumea_hv_loops_repeatSpeed[i], Haumea_hv_loops_repeatReversed[i]);
	}
	return false;
}

stock Haumea_hv_loops_CreateObjects()
{
	// ---- NPC paths (open.mp) ----
	new lane = NPC_CreatePath();
	NPC_AddPointToPath(lane, 1640.000000, -1700.000000, 13.500000, 0.50); // path point
	NPC_AddPointToPath(lane, 1680.000000, -1700.000000, 13.500000, 0.50); // path point
	new yard = NPC_CreatePath();
	NPC_AddPointToPath(yard, 1600.000000, -1700.000000, 13.500000, 0.20); // path point
	NPC_AddPointToPath(yard, 1620.000000, -1700.000000, 13.500000, 0.20); // path point
	NPC_AddPointToPath(yard, 1620.000000, -1720.000000, 13.500000, 0.20); // path point

	new guard = NPC_Create("YardGuard"); // lapd1 [NPC]
	NPC_Spawn(guard);
	NPC_SetSkin(guard, 280);
	NPC_SetPos(guard, 1600.000000, -1702.000000, 13.500000);
	NPC_SetFacingAngle(guard, 0.000000);
	new runner = NPC_Create("LaneRunner"); // lapd1 [NPC]
	NPC_Spawn(runner);
	NPC_SetSkin(runner, 280);
	NPC_SetPos(runner, 1640.000000, -1702.000000, 13.500000);
	NPC_SetFacingAngle(runner, 0.000000);
	new walker = NPC_Create("OnceWalker"); // lapd1 [NPC]
	NPC_Spawn(walker);
	NPC_SetSkin(walker, 280);
	NPC_SetPos(walker, 1640.000000, -1710.000000, 13.500000);
	NPC_SetFacingAngle(walker, 0.000000);

	// ---- NPC movement ----
	Haumea_hv_loops_MoveByPathRepeat(guard, yard, NPC_MOVE_TYPE_WALK, NPC_MOVE_SPEED_AUTO, false, NPC_PATH_LOOP);
	Haumea_hv_loops_MoveByPathRepeat(runner, lane, NPC_MOVE_TYPE_JOG, 0.5000, false, NPC_PATH_BACK_AND_FORTH);
	NPC_MoveByPath(walker, lane, NPC_MOVE_TYPE_WALK, NPC_MOVE_SPEED_AUTO, true);
}
