// Generated by Haumea Studio from GTA San Andreas map objects.
// This file uses absolute world coordinates and XYZ rotation degrees.
// Unchanged world objects are omitted from this file.
// A moved, rotated, deleted, or material-edited world object is exported
// as RemoveBuildingForPlayer plus a scripted replacement when it is not deleted.
// Call Haumea_hv_radar_CreateObjects() from OnGameModeInit (it also adds the player classes).
// Call Haumea_hv_radar_ShowForPlayer(playerid) from OnPlayerConnect for gang zones, map icons and sounds.

#tryinclude <open.mp>
#if !defined _INC_open_mp
	#include <a_samp>
#endif

static hv_radar_zone_0 = -1;
static hv_radar_zone_1 = -1;
static hv_radar_zone_2 = -1;

stock Haumea_hv_radar_CreateObjects()
{
	hv_radar_zone_0 = GangZoneCreate(2000.000000, -3004.000000, 2012.000000, -2996.000000); // gangzone [gang zone]
	hv_radar_zone_1 = GangZoneCreate(2000.000000, -2996.000000, 2004.000000, -2992.000000); // gangzone [gang zone]
	hv_radar_zone_2 = GangZoneCreate(2004.000000, -2996.000000, 2012.000000, -2992.000000); // gangzone [gang zone]
}

stock Haumea_hv_radar_ShowForPlayer(playerid)
{
	GangZoneShowForPlayer(playerid, hv_radar_zone_0, 0x8C7A5AC8); // gangzone
	GangZoneShowForPlayer(playerid, hv_radar_zone_1, 0x5A7A3CC8); // gangzone
	GangZoneShowForPlayer(playerid, hv_radar_zone_2, 0x9C9C9CC8); // gangzone
}
