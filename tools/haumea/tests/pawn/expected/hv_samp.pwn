	gate_zone = GangZoneCreate(1590.000000, -1910.000000, 1630.000000, -1870.000000); // gangzone [gang zone]

	// ---- Shop ----
	new sign = CreateObject(19353, 1604.000000, -1890.000000, 14.000000, 0.000000, 0.000000, 90.000000); // wall001 @group("Shop") @note("front sign")
