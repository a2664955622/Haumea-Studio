// Rotations kept as written: several triples give the same rotation (at
// gimbal lock, and 180,90,z = 0,-90,180+z), and an object nobody rotated
// must come back with the file's own numbers.
#include <a_samp>

stock RotationMap()
{
	CreateObject(19377, 2000.000000, -3000.000000, 4.000000, 180.000000, 90.000000, 0.000000);
	CreateObject(19377, 2004.000000, -3000.000000, 4.000000, 180.000000, 90.000000, 1.399999);
	CreateObject(19377, 2008.000000, -3000.000000, 4.000000, 89.999992, -45.199764, -89.999961);
	CreateObject(19377, 2012.000000, -3000.000000, 4.000000, 89.999992, 180.000030, -89.999961);
	CreateObject(19377, 2016.000000, -3000.000000, 4.000000, -89.999992, -44.349185, 90.850593);
	CreateObject(19377, 2020.000000, -3000.000000, 4.000000, 0.000000, 28.300006, 90.000106);
	CreateObject(19377, 2024.000000, -3000.000000, 4.000000, 0.000000, -178.800155, -89.899841);
	CreateObject(19377, 2028.000000, -3000.000000, 4.000000, 90.000030, 0.000000, -89.999938);
}
