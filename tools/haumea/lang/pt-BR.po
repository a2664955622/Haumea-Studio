msgstr "%d mostrados, construções do GTA removidas: %d"

#, c-format
msgid "%d similar models"
msgstr "%d modelos semelhantes"

#, c-format
msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "%d texto(s) com acentos ou símbolos são salvos em UTF-8, mas os clientes SA-MP e open.mp desenham em Windows-1252, então aparecem embaralhados (\"Ã§\" no lugar de \"ç\"). Salvar como > Windows-1252 resolve."

#, c-format
msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "%d textdraw(s) ainda estão no mapa, somente leitura: TextDraws > Mover para um arquivo separado para editá-los."

