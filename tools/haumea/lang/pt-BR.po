msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"Clique direito para guardá-lo nos Favoritos"

msgid "  (in the map, read-only)"
msgstr "  (no mapa, somente leitura)"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " (sem config.json no workspace para conferir o max_players)"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " Clientes 0.3.7 são permitidos e não os verão."

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " IDs personalizados fora do artconfig.txt e do AddSimpleModel: "

msgid " IDs: "
msgstr " IDs: "

#, c-format
msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "\"%s\" não está no TXD \"%s\" (nem nos pais dele); a textura original fica."

#, c-format
msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "\"%s\" não está no TXD do modelo personalizado %d; a textura original fica."

#, c-format
msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"\"%s\" não está instalada aqui. Esta fonte livre tem as mesmas larguras de letra,\n"
"então o texto cabe como no jogo; o formato das letras muda um pouco."

#, c-format
msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "\"%s\" não está instalada aqui; a prévia usa %s. Jogadores sem ela recebem a fonte substituta do Windows."

#, c-format
msgid "\"%s\" isn't a Pawn variable name"
msgstr "\"%s\" não é um nome de variável Pawn"

#, c-format
msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f graus)"

#, c-format
msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  ID do modelo %d -> %d"

#, c-format
msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  substituição(ões) de material"

#, c-format
msgid "%.0f FPS"
msgstr "%.0f FPS"

#, c-format
msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

#, c-format
msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f unidades | dX %.3f  dY %.3f  dZ %.3f"

#, c-format
msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"Clique duas vezes para colocar"

#, c-format
msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  %d instâncias"

#, c-format
msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s, acima do limite de %d do servidor; os excedentes não são criados."

#, c-format
msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "%d NPC(s) repetem ou vão e voltam pelo caminho: chame o <prefix>_OnNPCFinishMovePath(npcid, pathid) do mapa no OnNPCFinishMovePath do seu gamemode, senão eles param no fim do caminho."

#, c-format
msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "%d NPC(s) vão ocupar %d vaga(s) de jogador%s."

#, c-format
msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "%d NPCs se chamam \"%s\": os nomes precisam ser únicos, então só um é criado."

#, c-format
msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "%d NPCs estão no mesmo assento (%d) de um veículo: não cabem os dois ali."

#, c-format
msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "%d NPCs, mas o config.json permite %d jogadores e cada NPC ocupa uma vaga de jogador."

#, c-format
msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "%d chamadas de RemoveBuildingForPlayer, acima das %d por jogador do SA-MP: as demais continuam no mundo."

#, c-format
msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "%d chamadas de RemoveBuildingForPlayer: %d para áreas inteiras (modelo -1) e %d para construções avulsas."

#, c-format
msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "%d linha(s) RemoveBuildingForPlayer não correspondem a um prédio do GTA naquele lugar."

#, c-format
msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"%d elemento(s) SA-MP, %d veículo(s)\n"
"%s"

#, c-format
msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "%d adicionado(s), %d excluído(s), %d movido(s), %d girado(s), %d de material"

#, c-format
msgid "%d attached or referenced objects excluded from cleanup."
msgstr "%d objetos vinculados ou referenciados excluídos da limpeza."

#, c-format
msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "%d audio streams: o jogador ouve um de cada vez, o último iniciado."

#, c-format
msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "%d chamada(s) foram ignoradas porque a posição, o modelo ou o handle não é um valor simples (por exemplo uma fórmula ou uma variável que guarda coordenadas)."

#, c-format
msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "%d objeto(s) do mundo alterado(s) serão removidos por jogador com RemoveBuildingForPlayer e recriados pelo código Pawn exportado quando não forem excluídos."

#, c-format
msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "%d checkpoint(s) e %d race checkpoint(s): o jogador vê um de cada por vez, então o streamer mostra o mais próximo."

#, c-format
msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "%d checkpoint(s) não são escritos em código nativo (o jogador tem um checkpoint por vez, definido pelo script). Salve como código Streamer."

#, c-format
msgid "%d corner(s)"
msgstr "%d canto(s)"

#, c-format
msgid "%d days ago"
msgstr "há %d dias"

#, c-format
msgid "%d duplicates in %d groups"
msgstr "%d duplicados em %d grupos"

#, c-format
msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "%d área(s) dinâmica(s) não são escritas em código nativo (são do streamer). Salve como código Streamer."

#, c-format
msgid "%d element(s) are in another virtual world or interior"
msgstr "%d elemento(s) estão em outro virtual world ou interior"

#, c-format
msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "%d elemento(s) além do mapa de San Andreas (±%d). Funcionam, mas a água, o mapa e o radar do jogo acabam ali."

#, c-format
msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "%d elemento(s) fora dos limites do mundo do SA-MP (±%d): o servidor limita ou ignora essas posições."

#, c-format
msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "%d elemento(s) usam modelos personalizados: o servidor precisa deles no models/artconfig.txt (ou AddSimpleModel) e do artwork ativado%s; os jogadores precisam do SA-MP 0.3.DL ou de um cliente open.mp.%s"

#, c-format
msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "%d elementos usam o mesmo nome de variável \"%s\": o código Pawn não vai compilar."

#, c-format
msgid "%d errors"
msgstr "%d erros"

#, c-format
msgid "%d favourites"
msgstr "%d favoritos"

#, c-format
msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "%d gang zones para cada jogador (%d por jogador, %d globais), acima das %d que um jogador pode ter; as excedentes não aparecem."

#, c-format
msgid "%d global textdraws, over the limit of %d."
msgstr "%d textdraws globais, acima do limite de %d."

#, c-format
msgid "%d hidden"
msgstr "%d ocultos"

#, c-format
msgid "%d in map"
msgstr "%d no mapa"

#, c-format
msgid "%d in the map (read-only)"
msgstr "%d no mapa (somente leitura)"

#, c-format
msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "%d item(ns) estão configurados para aparecer só dentro de uma área dinâmica, mas o código nativo os mostra em todo lugar. Salve como código Streamer."

#, c-format
msgid "%d item(s) only inside it"
msgstr "%d item(ns) só dentro dela"

#, c-format
msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "%d item(ns) só aparecem dentro de uma dynamic area onde a câmera não está"

#, c-format
msgid "%d item(s) shown only inside it"
msgstr "%d item(ns) mostrados só dentro dela"

#, c-format
msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "%d linha(s) de material, anexo ou interior se referiam a objetos que foram ignorados."

#, c-format
msgid "%d models | %d instances"
msgstr "%d modelos | %d instâncias"

#, c-format
msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "%d objeto(s) usam modelos que o editor não tem (%s). Modelos de outros mods não estão disponíveis."

#, c-format
msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "%d objeto(s) usam a fonte \"%s\", que não está instalada aqui: a prévia usa %s. Os jogadores só a veem se tiverem a fonte. Para pré-visualizá-la, coloque o .ttf dela na pasta de fontes (Informações do objeto, Abrir pasta de fontes) e procure de novo."

#, c-format
msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "%d objeto(s) com modelos que o editor não conhece ficaram de fora ao abrir o mapa, e salvar os descarta.%s%s%s%s"

#, c-format
msgid "%d objects"
msgstr "%d objetos"

#, c-format
msgid "%d objects along this path"
msgstr "%d objetos ao longo deste caminho"

#, c-format
msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "%d objetos visíveis / %d criados (nativo, limite 1000)"

#, c-format
msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "%d objetos visíveis / %d no stream (de %d no alcance, limite 1000)"

#, c-format
msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "%d objetos a até %.0f m de um ponto: um cliente 0.3.7 mostra no máximo %d de uma vez, então o streamer vai deixar alguns de fora ali."

#, c-format
msgid "%d objects, %d x %d cells"
msgstr "%d objetos, %d x %d células"

#, c-format
msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "%d objetos, %d x %d células (alguns sem área de base)"

#, c-format
msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "%d objetos, mas o CreateObject para em %d (%s). Objetos além do limite não são criados; salve com código Streamer."

#, c-format
msgid "%d of %d"
msgstr "%d de %d"

#, c-format
msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "%d de %d objetos (%s): sobra pouco espaço para o resto do gamemode."

#, c-format
msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "%d desses modelos foram importados para a pasta modloader/Haumea do jogo, que os jogadores do SA-MP não têm. Eles podem virar modelos personalizados na pasta models do servidor (SA-MP 0.3.DL / open.mp)."

#, c-format
msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "%d gang zone(s) por jogador ou com streamer: o CreatePlayerGangZone só compila e funciona no open.mp, não em um servidor SA-MP 0.3.7. Para o 0.3.7, defina-as como Global (Informações do objeto > Mostrado como, ou o Mostrado como da arte de radar)."

#, c-format
msgid "%d player textdraws, over the limit of %d per player."
msgstr "%d textdraws de jogador, acima do limite de %d por jogador."

#, c-format
msgid "%d points"
msgstr "%d pontos"

#, c-format
msgid "%d selected world object(s) will be replaced in the map."
msgstr "%d objeto(s) do mundo selecionado(s) serão substituídos no mapa."

#, c-format
msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "%d selecionados · Arraste o gizmo para mover ou girar · %s exclui."

#, c-format
msgid "%d selected, %d of this kind"
msgstr "%d selecionados, %d deste tipo"

#, c-format
