msgstr "%d veículos, %d atores no stream  |  virtual world %d, interior %d"

#, c-format
msgid "%d vehicles, over the limit of %d."
msgstr "%d veículos, acima do limite de %d."

#, c-format
msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "%d construção(ões) do mundo mostradas aqui estão dentro de uma remoção de modelo -1: no jogo continuam removidas."

#, c-format
msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "%d objeto(s) do mundo neste escopo de exportação não foram alterados e serão omitidos. Mova, gire, edite ou exclua um se ele deve virar uma alteração em Pawn."

