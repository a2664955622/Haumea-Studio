# Haumea Studio, Simplified Chinese (zh-CN).
# See docs/i18n/GLOSSARY.zh-CN.md for terminology and conventions.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Name: 简体中文\n"

msgid ""
"\n"
"Right-click to keep it in Favourites"
msgstr ""
"\n"
"右键点击可将它保留在收藏夹"

msgid "  (in the map, read-only)"
msgstr "  （在地图中，只读）"

msgid " (no config.json in the workspace to check max_players against)"
msgstr " （工作区内没有 config.json 可用来核对 max_players）"

msgid " 0.3.7 clients are allowed and won't see them."
msgstr " 允许 0.3.7 客户端加入，它们不会看到这些内容。"

msgid " Custom IDs not in artconfig.txt or AddSimpleModel: "
msgstr " 不在 artconfig.txt 或 AddSimpleModel 中的自定义 ID： "

msgid " IDs: "
msgstr " ID： "

#, c-format
msgid "\"%s\" is not in TXD \"%s\" (or its parents); the original texture stays."
msgstr "\"%s\" 不在 TXD \"%s\"（或其父级）中；将保留原始贴图。"

#, c-format
msgid "\"%s\" is not in custom model %d's TXD; the original texture stays."
msgstr "\"%s\" 不在自定义模型 %d 的 TXD 中；将保留原始贴图。"

#, c-format
msgid ""
"\"%s\" is not installed here. This free font has the same letter widths,\n"
"so the text fits as in game; the letter shapes differ a little."
msgstr ""
"\"%s\" 未在此安装。这款免费字体的字宽相同，\n"
"因此文本能像游戏中一样放得下；字形略有差异。"

#, c-format
msgid "\"%s\" is not installed here; the preview uses %s. Players without it get Windows' substitute font."
msgstr "\"%s\" 未在此安装；预览将使用 %s。没有该字体的玩家会得到 Windows 的替代字体。"

#, c-format
msgid "\"%s\" isn't a Pawn variable name"
msgstr "\"%s\" 不是 Pawn 变量名"

#, c-format
msgid "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f deg)"
msgstr "%-3s %-20s  %.1f, %.1f, %.1f  (%.1f 度)"

#, c-format
msgid "%-3s %-20s  Model ID %d -> %d"
msgstr "%-3s %-20s  模型 ID %d -> %d"

#, c-format
msgid "%-3s %-20s  material override(s)"
msgstr "%-3s %-20s  材质覆盖"

#, c-format
msgid "%.0f FPS"
msgstr "%.0f FPS"

#, c-format
msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

#, c-format
msgid "%.3f units | dX %.3f  dY %.3f  dZ %.3f"
msgstr "%.3f 单位 | dX %.3f  dY %.3f  dZ %.3f"

#, c-format
msgid ""
"%d  %s\n"
"Double-click to place"
msgstr ""
"%d  %s\n"
"双击放置"

#, c-format
msgid "%d  %s  |  %d instances"
msgstr "%d  %s  |  %d 个实例"

#, c-format
msgid "%d %s, over the server's limit of %d; the extra ones are not created."
msgstr "%d %s，超过服务器的 %d 上限；多出的不会被创建。"

#, c-format
msgid "%d NPC(s) loop or walk back and forth along their path: call the map's <prefix>_OnNPCFinishMovePath(npcid, pathid) from your gamemode's OnNPCFinishMovePath, or they stop at the path's end."
msgstr "%d 个 NPC 会沿路径循环或来回走动：请在你 gamemode 的 OnNPCFinishMovePath 中调用地图的 <prefix>_OnNPCFinishMovePath(npcid, pathid)，否则它们会在路径终点停下。"

#, c-format
msgid "%d NPC(s) will take %d player slot(s)%s."
msgstr "%d 个 NPC 将占用 %d 个玩家槽位%s。"

#, c-format
msgid "%d NPCs are named \"%s\": names must be unique, so only one is created."
msgstr "%d 个 NPC 都叫 \"%s\"：名称必须唯一，因此只会创建一个。"

#, c-format
msgid "%d NPCs sit in the same seat (%d) of one vehicle: they can't both sit there."
msgstr "%d 个 NPC 坐在同一辆载具的同一个座位（%d）上：它们无法都坐在那里。"

#, c-format
msgid "%d NPCs, but config.json allows %d players and every NPC takes a player slot."
msgstr "%d 个 NPC，但 config.json 允许 %d 名玩家，而每个 NPC 都会占用一个玩家槽位。"

#, c-format
msgid "%d RemoveBuildingForPlayer calls, over SA-MP's %d per player: the rest stay in the world."
msgstr "%d 次 RemoveBuildingForPlayer 调用，超过 SA-MP 每名玩家 %d 的上限：其余的仍留在世界中。"

#, c-format
msgid "%d RemoveBuildingForPlayer calls: %d for whole areas (model -1) and %d for single buildings."
msgstr "%d 次 RemoveBuildingForPlayer 调用：%d 次针对整个区域（model -1），%d 次针对单个建筑。"

#, c-format
msgid "%d RemoveBuildingForPlayer line(s) did not match a GTA building at that spot."
msgstr "%d 行 RemoveBuildingForPlayer 在该位置没有匹配到任何 GTA 建筑。"

#, c-format
msgid ""
"%d SA-MP element(s), %d vehicle(s)\n"
"%s"
msgstr ""
"%d 个 SA-MP 元素，%d 辆载具\n"
"%s"

#, c-format
msgid "%d added, %d deleted, %d moved, %d rotated, %d material"
msgstr "%d 个已添加，%d 个已删除，%d 个已移动，%d 个已旋转，%d 个材质"

#, c-format
msgid "%d audio streams: a player hears one at a time, the last one started."
msgstr "%d 个音频流：玩家一次只能听到一个，即最后开始播放的那个。"

#, c-format
msgid "%d call(s) were skipped because their position, model or handle is not a plain value (for example a formula or a variable that holds coordinates)."
msgstr "%d 次调用被跳过，因为其位置、模型或句柄不是简单值（例如公式或保存坐标的变量）。"

#, c-format
msgid "%d changed world object(s) will be removed per player with RemoveBuildingForPlayer and recreated by the exported Pawn code when they are not deleted."
msgstr "%d 个已更改的世界物体将通过 RemoveBuildingForPlayer 按玩家移除，若未被删除则会由导出的 Pawn 代码重新创建。"

#, c-format
msgid "%d checkpoint(s) and %d race checkpoint(s): a player sees one of each at a time, so the streamer shows the nearest."
msgstr "%d 个 checkpoint 和 %d 个 race checkpoint：玩家每种一次只能看到一个，因此 streamer 会显示最近的那个。"

#, c-format
msgid "%d checkpoint(s) are not written in native code (a player has one checkpoint at a time, set by the script). Save as Streamer code."
msgstr "%d 个 checkpoint 不会以原生代码写入（玩家同一时间只能有一个由脚本设置的 checkpoint）。请保存为 Streamer 代码。"

#, c-format
msgid "%d corner(s)"
msgstr "%d 个角点"

#, c-format
msgid "%d days ago"
msgstr "%d 天前"

#, c-format
msgid "%d dynamic area(s) are not written in native code (they are the streamer's). Save as Streamer code."
msgstr "%d 个动态区域不会以原生代码写入（它们属于 streamer）。请保存为 Streamer 代码。"

#, c-format
msgid "%d element(s) are in another virtual world or interior"
msgstr "%d 个元素位于其他 virtual world 或内部"

#, c-format
msgid "%d element(s) beyond the San Andreas map (±%d). They work, but the game's water, map and radar end there."
msgstr "%d 个元素位于 San Andreas 地图之外（±%d）。它们可以使用，但游戏的水面、地图和雷达到那里就结束了。"

#, c-format
msgid "%d element(s) outside SA-MP's world bounds (±%d): the server clamps or ignores those positions."
msgstr "%d 个元素超出 SA-MP 的世界边界（±%d）：服务器会限制或忽略这些位置。"

#, c-format
msgid "%d element(s) use custom models: the server needs them in models/artconfig.txt (or AddSimpleModel) and artwork enabled%s; players need SA-MP 0.3.DL or an open.mp client.%s"
msgstr "%d 个元素使用自定义模型：服务器需要在 models/artconfig.txt（或 AddSimpleModel）中提供它们并启用 artwork%s；玩家需要 SA-MP 0.3.DL 或 open.mp 客户端。%s"

#, c-format
msgid "%d elements share the variable name \"%s\": the Pawn code won't compile."
msgstr "%d 个元素共用了变量名 \"%s\"：Pawn 代码将无法编译。"

#, c-format
msgid "%d errors"
msgstr "%d 个错误"

#, c-format
msgid "%d favourites"
msgstr "%d 个收藏"

#, c-format
msgid "%d gang zones for every player (%d per-player, %d global), over the %d a player can have; the extra ones are not shown."
msgstr "%d 个 gang zone 对每名玩家生效（%d 个按玩家，%d 个全局），超过了每名玩家可拥有的 %d 个上限；多出的不会显示。"

#, c-format
msgid "%d global textdraws, over the limit of %d."
msgstr "%d 个全局 textdraw，超过 %d 的上限。"

#, c-format
msgid "%d hidden"
msgstr "%d 个已隐藏"

#, c-format
msgid "%d in map"
msgstr "%d 个在地图中"

#, c-format
msgid "%d in the map (read-only)"
msgstr "%d 个在地图中（只读）"

#, c-format
msgid "%d item(s) are set to show only inside a dynamic area, but native code shows them everywhere. Save as Streamer code."
msgstr "%d 个项目被设置为仅在动态区域内显示，但原生代码会让它们到处显示。请保存为 Streamer 代码。"

#, c-format
msgid "%d item(s) only inside it"
msgstr "%d 个项目仅在其中"

#, c-format
msgid "%d item(s) only show inside a dynamic area the camera is outside"
msgstr "%d 个项目仅在相机位于其外的动态区域内显示"

#, c-format
msgid "%d item(s) shown only inside it"
msgstr "%d 个项目仅显示在其中"

#, c-format
msgid "%d material, attachment or interior line(s) referred to objects that were skipped."
msgstr "%d 行材质、附加或内部设置引用了被跳过的物体。"

#, c-format
msgid "%d models | %d instances"
msgstr "%d 个模型 | %d 个实例"

#, c-format
msgid "%d object(s) use models the editor does not have (%s). Models from other mods are not available."
msgstr "%d 个物体使用了编辑器没有的模型（%s）。其他 mod 的模型不可用。"

#, c-format
msgid "%d object(s) use the font \"%s\", which isn't installed here: the preview uses %s. Players see it only if they have the font. To preview it, put its .ttf in the fonts folder (Object Info, Open fonts folder) and rescan."
msgstr "%d 个物体使用了字体 \"%s\"，但该字体未在此安装：预览将使用 %s。玩家只有拥有该字体才能看到它。要预览它，请把它的 .ttf 放入字体文件夹（物体信息、打开字体文件夹）并重新扫描。"

#, c-format
msgid "%d object(s) with models the editor doesn't know were left out when the map was opened, and saving drops them.%s%s%s%s"
msgstr "%d 个物体使用了编辑器不认识的模型，打开地图时被排除在外，保存时会将它们丢弃。%s%s%s%s"

#, c-format
msgid "%d objects"
msgstr "%d 个物体"

#, c-format
msgid "%d objects visible / %d created (native, limit 1000)"
msgstr "%d 个物体可见 / %d 个已创建（原生，上限 1000）"

#, c-format
msgid "%d objects visible / %d streamed (of %d in stream range, limit 1000)"
msgstr "%d 个物体可见 / %d 个已流送（流送范围内共 %d 个，上限 1000）"

#, c-format
msgid "%d objects within %.0f m of one spot: a 0.3.7 client shows at most %d at once, so the streamer will leave some out there."
msgstr "%d 个物体聚集在一点周围 %.0f m 内：0.3.7 客户端一次最多显示 %d 个，因此 streamer 在那里会略去一些。"

#, c-format
msgid "%d objects, %d x %d cells"
msgstr "%d 个物体，%d x %d 格子"

#, c-format
msgid "%d objects, %d x %d cells (some without a footprint)"
msgstr "%d 个物体，%d x %d 格子（部分没有占地面积）"

#, c-format
msgid "%d objects, but CreateObject stops at %d (%s). Objects past the limit are not created; save with Streamer code instead."
msgstr "%d 个物体，但 CreateObject 会在 %d 处停止（%s）。超出上限的物体不会被创建；请改用 Streamer 代码保存。"

#, c-format
msgid "%d of %d"
msgstr "%d / %d"

#, c-format
msgid "%d of %d objects (%s): the rest of the gamemode has little room left."
msgstr "%d / %d 个物体（%s）：gamemode 其余部分几乎没有余量了。"

#, c-format
msgid "%d of those models were imported into the game's modloader/Haumea folder, which SA-MP players don't have. They can become custom models in the server's models folder (SA-MP 0.3.DL / open.mp)."
msgstr "%d 个此类模型被导入到了游戏的 modloader/Haumea 文件夹，而 SA-MP 玩家并没有这个文件夹。它们可以在服务器的 models 文件夹中成为自定义模型（SA-MP 0.3.DL / open.mp）。"

#, c-format
msgid "%d per-player or streamed gang zone(s): CreatePlayerGangZone only compiles and runs on open.mp, not on a SA-MP 0.3.7 server. For 0.3.7, set them to Global (Object Info > Shown as, or radar art's Shown as)."
msgstr "%d 个按玩家或流送的 gang zone：CreatePlayerGangZone 只能在 open.mp 上编译并运行，在 SA-MP 0.3.7 服务器上则不行。对于 0.3.7，请将它们设为全局（物体信息 > 显示方式，或 radar art 的显示方式）。"

#, c-format
msgid "%d player textdraws, over the limit of %d per player."
msgstr "%d 个玩家 textdraw，超过每名玩家 %d 的上限。"

#, c-format
msgid "%d points"
msgstr "%d 个点"

#, c-format
msgid "%d selected world object(s) will be replaced in the map."
msgstr "%d 个选中的世界物体将在地图中被替换。"

#, c-format
msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "已选中 %d 个 · 拖动 gizmo 移动或旋转 · %s 删除。"

#, c-format
msgid "%d selected, %d of this kind"
msgstr "%d 个已选中，%d 个为此类型"

#, c-format
msgid "%d selected: changes go to all of them."
msgstr "%d 个已选中：更改将应用于全部。"

#, c-format
msgid "%d shown"
msgstr "%d 个已显示"

#, c-format
msgid "%d shown, GTA buildings removed: %d"
msgstr "%d 个已显示，已移除的 GTA 建筑：%d"

#, c-format
msgid "%d similar models"
msgstr "%d 个相似模型"

#, c-format
msgid "%d text(s) with accents or symbols are saved as UTF-8, but SA-MP and open.mp clients draw Windows-1252, so they show garbled (\"Ã§\" for \"ç\"). Save As > Windows-1252 fixes it."
msgstr "%d 处文本含有重音符号或特殊符号，按 UTF-8 保存，但 SA-MP 和 open.mp 客户端按 Windows-1252 绘制文本，因此会显示乱码（\"ç\" 显示成 \"Ã§\"）。另存为 > Windows-1252 可以解决。"

#, c-format
msgid "%d textdraw(s) are still in the map, read-only: TextDraws > Move to a separate file to edit them."
msgstr "%d 个 textdraw 仍在地图中且为只读：请用 TextDraws > 移动到单独的文件来编辑它们。"

#, c-format
msgid "%d textdraws"
msgstr "%d 个 textdraw"

#, c-format
msgid "%d texture(s)"
msgstr "%d 个贴图"

#, c-format
msgid "%d trailing bytes ignored"
msgstr "%d 个末尾字节已忽略"

#, c-format
msgid "%d vehicle ids (%d of them for trains, 4 each), over the limit of %d."
msgstr "%d 个载具 ID（其中 %d 个用于火车，每列 4 个），超过 %d 的上限。"

#, c-format
msgid "%d vehicles, %d actors streamed  |  virtual world %d, interior %d"
msgstr "%d 辆载具，%d 个演员已流送  |  virtual world %d，内部 %d"

#, c-format
msgid "%d vehicles, over the limit of %d."
msgstr "%d 辆载具，超过 %d 的上限。"

#, c-format
msgid "%d world building(s) shown here are inside a model -1 removal: in game they stay removed."
msgstr "此处显示的 %d 个世界建筑处于一处 model -1 移除范围内：在游戏中它们会保持移除状态。"

#, c-format
msgid "%d world object(s) in this export scope are unchanged and will be omitted. Move, rotate, edit, or delete one if it should become a Pawn change."
msgstr "此导出范围内有 %d 个世界物体没有更改，将被省略。如果某个物体应当成为 Pawn 更改，请移动、旋转、编辑或删除它。"

#, c-format
msgid "%d x %d pixels"
msgstr "%d x %d 像素"

#, c-format
msgid "%d x %d texture, as SA-MP renders it"
msgstr "%d x %d 贴图，按 SA-MP 渲染的效果显示"

#, c-format
msgid "%d zones"
msgstr "%d 个区域"

#, c-format
msgid "%d zones, at most %d around a player"
msgstr "%d 个区域，每名玩家周围最多 %d 个"

#, c-format
msgid ""
"%s\n"
"\n"
"Or in ~/.codex/config.toml:\n"
"%s"
msgstr ""
"%s\n"
"\n"
"或在 ~/.codex/config.toml 中：\n"
"%s"

#, c-format
msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"%d 个实例，%d 个 SA-MP 元素，%d 辆载具\n"
"%s\n"
"双击放置"

#, c-format
msgid ""
"%s\n"
"%d instance(s), %d SA-MP element(s), %d vehicle(s)\n"
"Tags: %s\n"
"%s\n"
"Double-click to place"
msgstr ""
"%s\n"
"%d 个实例，%d 个 SA-MP 元素，%d 辆载具\n"
"标签：%s\n"
"%s\n"
"双击放置"

#, c-format
msgid ""
"%s\n"
"Double-click to open it."
msgstr ""
"%s\n"
"双击即可打开。"

#, c-format
msgid ""
"%s\n"
"Include it in your gamemode and call %s_CreateTextDraws()\n"
"from OnGameModeInit and %s_ShowTextDraws(playerid)."
msgstr ""
"%s\n"
"把它包含进你的 gamemode，并从 OnGameModeInit 调用 %s_CreateTextDraws()\n"
"和 %s_ShowTextDraws(playerid)。"

#, c-format
msgid ""
"%s\n"
"Native code, %s text"
msgstr ""
"%s\n"
"原生代码，%s 文本"

#, c-format
msgid ""
"%s\n"
"Streamer code, %s text"
msgstr ""
"%s\n"
"Streamer 代码，%s 文本"

#, c-format
msgid ""
"%s\n"
"TXD %s, model %d\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s，模型 %d\n"
"单击应用；右击可保留在收藏夹。"

#, c-format
msgid ""
"%s\n"
"TXD %s, model %d (no model loads this TXD)\n"
"Click applies it; right-click keeps it in Favourites."
msgstr ""
"%s\n"
"TXD %s，模型 %d（没有模型加载此 TXD）\n"
"单击应用；右击可保留在收藏夹。"

#, c-format
msgid "%s  (%d points)"
msgstr "%s  （%d 个点）"

#, c-format
msgid "%s  model %d"
msgstr "%s  模型 %d"

#, c-format
msgid "%s (missing)"
msgstr "%s（缺失）"

#, c-format
msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s 浏览 · %s 地图物体 · %s 保存 · %s 快捷键"

#, c-format
msgid "%s The update installs the next time Haumea starts."
msgstr "%s 更新将在 Haumea 下次启动时安装。"

#, c-format
msgid "%s already sits there."
msgstr "%s 已经坐在那里了。"

#, c-format
msgid "%s already uses this name."
msgstr "%s 已在使用此名称。"

#, c-format
msgid "%s drops the selected objects onto the ground."
msgstr "%s 将所选物体放到地面上。"

#, c-format
msgid "%s exists: it is used as it is."
msgstr "%s 已存在：将按原样使用。"

#, c-format
msgid "%s follows path \"%s\", which has no points."
msgstr "%s 沿路径 \"%s\" 行走，但该路径没有点。"

#, c-format
msgid "%s follows path \"%s\", which has one point: it walks there and stops."
msgstr "%s 沿路径 \"%s\" 行走，该路径只有一个点：它会走到那里然后停下。"

#, c-format
msgid "%s has no text."
msgstr "%s 没有文本。"

#, c-format
msgid "%s is %.0f m off the track: in game it stands on the nearest track instead, at %.1f, %.1f, %.1f."
msgstr "%s 偏离轨道 %.0f m：在游戏中它会站在最近的轨道上，位置为 %.1f, %.1f, %.1f。"

#, c-format
msgid "%s is at the %d-character limit and may have been cut."
msgstr "%s 已达到 %d 字符上限，可能已被截断。"

#, c-format
msgid "%s is attached to an object that was deleted."
msgstr "%s 附着在一个已删除的物体上。"

#, c-format
msgid "%s is set to show only inside area \"%s\", which is not in the map: it is written without one and shows everywhere."
msgstr "%s 被设置为仅在区域 \"%s\" 内显示，但该区域不在地图中：写入时不带区域，到处都会显示。"

#, c-format
msgid "%s isn't next to the editor. It ships with every release, and is in the source at https://github.com/itsneufox/Haumea-Studio."
msgstr "%s 不在编辑器旁边。它随每个新版本一同发布，也包含在 https://github.com/itsneufox/Haumea-Studio 的源码中。"

#, c-format
msgid "%s lists every keyboard shortcut; change them in Preferences."
msgstr "%s 列出所有键盘快捷键；可在首选项中修改。"

#, c-format
msgid "%s only shows inside area \"%s\", but they are in different virtual worlds or interiors: no player is ever in both."
msgstr "%s 仅在区域 \"%s\" 内显示，但二者位于不同的 virtual world 或内部：不会有玩家同时处于两者之中。"

#, c-format
msgid "%s pastes objects exactly where they were copied."
msgstr "%s 将物体粘贴到复制时的原位置。"

#, c-format
msgid "%s plays driver recording %s but isn't driving a vehicle: open.mp reports it playing, yet the NPC never moves. Put it in a vehicle as the driver."
msgstr "%s 正在播放驾驶录制 %s，但它并没有在驾驶载具：open.mp 报告其在播放，然而该 NPC 永远不会移动。请把它作为驾驶员放进载具。"

#, c-format
