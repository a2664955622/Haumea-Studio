// The exe's version info, 1,41,0,<build>, from haumea_buildinfo.h
// (tools/release/gen_buildinfo.py writes it before the build).
#include <winver.h>
#include "haumea_buildinfo.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HAUMEA_FILEVERSION
PRODUCTVERSION HAUMEA_FILEVERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Haumea Studio"
			VALUE "FileVersion", HAUMEA_FULL_VERSION
			VALUE "ProductName", "Haumea Studio"
			VALUE "ProductVersion", HAUMEA_FULL_VERSION
			VALUE "Comments", HAUMEA_COMMIT
			VALUE "OriginalFilename", "haumea.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
