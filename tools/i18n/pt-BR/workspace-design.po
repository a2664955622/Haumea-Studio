msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Advanced"
msgstr "Avançado"

msgid "Restores the browser on the left and Object Info on the right."
msgstr "Restaura o navegador à esquerda e as informações do objeto à direita."

msgid "Step snapping"
msgstr "Ajustar por incrementos"

msgid "%.0f FPS"
msgstr "%.0f FPS"

msgid "Performance"
msgstr "Desempenho"

msgid "Frame rate"
msgstr "Taxa de quadros"

msgid "VSync"
msgstr "Sincronização vertical"

msgid "Limit frame rate"
msgstr "Limitar taxa de quadros"

msgid "Uncapped"
msgstr "Sem limite"

msgid "%.0f FPS  /  %.1f ms"
msgstr "%.0f FPS  /  %.1f ms"

msgid "One distance for all objects, independent of model, weather and time of day."
msgstr "Uma distância para todos os objetos, independentemente do modelo, clima e horário."

msgid "Higher distances show more objects and use more GPU and memory."
msgstr "Distâncias maiores exibem mais objetos e usam mais GPU e memória."

msgid "Matches the display refresh rate to reduce tearing. Turn off for uncapped FPS."
msgstr "Sincroniza com a taxa de atualização da tela. Desative para não limitar o FPS."

msgid "Distance fog"
msgstr "Névoa à distância"

msgid "Previews virtual worlds, interiors, areas and client object limits.\nAll elements keep the stream distance set in Performance. Nothing is saved."
msgstr "Prévia dos mundos virtuais, interiores, áreas e limites de objetos do cliente.\nTodos os elementos usam a distância definida em Desempenho. Nada é salvo."

msgid "Recent workspaces"
msgstr "Áreas de trabalho recentes"

msgid "Folder missing"
msgstr "Pasta não encontrada"

msgid "Remove from recent"
msgstr "Remover dos recentes"

msgid "No recent maps"
msgstr "Nenhum mapa recente"

msgid "Choose a workspace to get started."
msgstr "Escolha uma área de trabalho para começar."

msgid "Open a map in this workspace and it will appear here."
msgstr "Abra um mapa nesta área de trabalho para que ele apareça aqui."

msgid "Return to the editor."
msgstr "Voltar ao editor."

msgid "Pick up where you left off."
msgstr "Continue de onde parou."

msgid "Your maps"
msgstr "Seus mapas"

msgid "Recent maps"
msgstr "Mapas recentes"

msgid "Background windows run at up to 30 FPS."
msgstr "Janelas em segundo plano usam até 30 FPS."

msgid "Characters"
msgstr "Personagens"

msgid "Blends distant objects into the horizon to soften the stream cutoff."
msgstr "Mistura objetos distantes com o horizonte para suavizar o limite de streaming."

msgid "Place a character with a skin and animation."
msgstr "Coloque um personagem com skin e animação."

msgid "Add a player spawn point."
msgstr "Adicione um ponto de surgimento de jogadores."

msgid "Place an NPC that can move and interact."
msgstr "Coloque um NPC que pode se mover e interagir."

msgid "Build an NPC path, one point at a time."
msgstr "Crie um caminho para NPCs, um ponto de cada vez."

msgid "Place an item players can collect."
msgstr "Coloque um item que os jogadores podem coletar."

msgid "Add text in the 3D world."
msgstr "Adicione texto ao mundo 3D."

msgid "Mark a coloured area on the radar."
msgstr "Marque uma área colorida no radar."

msgid "Add a marker to the radar."
msgstr "Adicione um marcador ao radar."

msgid "Play a sound or audio stream near this point."
msgstr "Reproduza um som ou áudio próximo deste ponto."

msgid "Place a checkpoint or add it to a race."
msgstr "Coloque um checkpoint ou adicione-o a uma corrida."

msgid "Limit streamed elements to an area."
msgstr "Limite os elementos transmitidos a uma área."

msgid "Paths"
msgstr "Caminhos"

msgid "Markers"
msgstr "Marcadores"

msgid "Text & audio"
msgstr "Texto e áudio"

msgid "Model files"
msgstr "Arquivos de modelos"

msgid "%d points"
msgstr "%d pontos"

msgid "New path"
msgstr "Novo caminho"

msgid "Click in the world. Esc stops."
msgstr "Clique no mundo. Esc para encerrar."

msgid "Choose Characters, Markers, Text & audio or Zones in the browser."
msgstr "Escolha Personagens, Marcadores, Texto e áudio ou Zonas no navegador."

msgid "Choose Paths in the browser, then place the points of a route."
msgstr "Escolha Caminhos no navegador e coloque os pontos de uma rota."

msgid "No dynamic areas. Choose Zones in the browser to add one."
msgstr "Nenhuma área dinâmica. Escolha Zonas no navegador para adicionar uma."

msgid "No points yet. Choose Paths in the browser to add them."
msgstr "Nenhum ponto ainda. Escolha Caminhos no navegador para adicioná-los."

msgid "Map elements"
msgstr "Elementos do mapa"

#, c-format
msgid "%d selected · Drag gizmo to move or rotate · %s deletes."
msgstr "%d selecionados · Arraste o gizmo para mover ou girar · %s exclui."

#, c-format
msgid "%s Browse · %s Map objects · %s Save · %s Shortcuts"
msgstr "%s Navegar · %s Objetos do mapa · %s Salvar · %s Atalhos"

msgid "Brush with this object"
msgstr "Pintar com este objeto"

msgid "Choose Place, then click the world. Double-click a tile also works."
msgstr "Escolha Colocar e clique no mundo. Um clique duplo na miniatura também funciona."

msgid "Choose an object, then click the world to place it."
msgstr "Escolha um objeto e clique no mundo para colocá-lo."

msgid "Choose or create a workspace."
msgstr "Escolha ou crie um workspace."

#, c-format
msgid "Click or drag to paint · %s stops."
msgstr "Clique ou arraste para pintar · %s encerra."

#, c-format
msgid "Click to place · Shift+click repeats · %s stops."
msgstr "Clique para colocar · Shift+clique repete · %s encerra."

msgid "Continue without workspace"
msgstr "Continuar sem workspace"

msgid "Create a workspace folder."
msgstr "Criar uma pasta de workspace."

msgid "Dark"
msgstr "Escuro"

#, c-format
msgid "Drag to move · drag a corner to resize · %s stops."
msgstr "Arraste para mover · arraste um canto para redimensionar · %s encerra."

#, c-format
msgid "Draw distance %.0f  ·  LOD %s"
msgstr "Distância de desenho %.0f  ·  LOD %s"

msgid "Edit Pawn · Ctrl+S saves · Ctrl+F searches."
msgstr "Edite Pawn · Ctrl+S salva · Ctrl+F busca."

msgid "Find similar models"
msgstr "Buscar modelos semelhantes"

msgid "Follow ground"
msgstr "Seguir o chão"

msgid "Game folder"
msgstr "Pasta do jogo"

msgid "Hold Shift while moving with the magnet on."
msgstr "Segure Shift ao mover com o ímã ativado."

msgid "Hold Shift while rotating with the magnet on."
msgstr "Segure Shift ao girar com o ímã ativado."

#, c-format
msgid "ID %d"
msgstr "ID %d"

msgid "Keep dragged objects on the ground surface."
msgstr "Manter os objetos arrastados na superfície do chão."

msgid "Line up edges and faces with nearby objects while moving."
msgstr "Alinhar bordas e faces com os objetos próximos ao mover."

msgid "Match the object's angle to the ground slope. Enable Follow ground in More on the toolbar."
msgstr "Alinhar o ângulo do objeto à inclinação do chão. Ative Seguir o chão em Mais na barra de ferramentas."

msgid "More actions"
msgstr "Mais ações"

msgid "More display and snapping options"
msgstr "Mais opções de exibição e ajuste"

msgid "New objects sit on the object under the cursor."
msgstr "Novos objetos ficam sobre o objeto sob o cursor."

msgid "New workspace"
msgstr "Novo workspace"

msgid "Object snap"
msgstr "Ajustar a objetos"

#, c-format
msgid "Object snap (%s) uses this distance."
msgstr "O ajuste a objetos (%s) usa esta distância."

msgid "Open folder..."
msgstr "Abrir pasta..."

msgid "Open last workspace at startup"
msgstr "Abrir o último workspace ao iniciar"

msgid "Pick an object, then click in the world to place it."
msgstr "Escolha um objeto e clique no mundo para colocá-lo."

msgid "Placement"
msgstr "Colocação"

msgid "SA-MP client not found"
msgstr "Cliente SA-MP não encontrado"

msgid "SA-MP's own objects won't show without its client files."
msgstr "Os objetos do SA-MP não aparecem sem os arquivos do cliente."

msgid "Show object edges, including invisible and see-through objects."
msgstr "Mostrar as bordas dos objetos, incluindo os invisíveis e transparentes."

msgid "Start with a category."
msgstr "Comece por uma categoria."

msgid "Switch between tiles and list. Right-click for tile size."
msgstr "Alternar entre miniaturas e lista. Clique com o botão direito para ajustar o tamanho."

#, c-format
msgid "TXD %s"
msgstr "TXD %s"

msgid "Theme"
msgstr "Tema"

#, c-format
msgid "|  Custom models: %d"
msgstr "|  Modelos personalizados: %d"
